# ─── Vortex configuration ──────────────────────────────────────────────────────
# Copy to .env and adjust. No third-party API keys are needed anywhere.

# --- API ---------------------------------------------------------------------
VORTEX_ENV=development
# true  = just you, no login.
# false = server mode: everyone who opens the site creates an account (argon2 passwords)
#         and only sees their own conversations.
VORTEX_LOCAL_MODE=true
# Allow new accounts to sign up (server mode).
VORTEX_ALLOW_REGISTRATION=true
# Session length in hours (cookie renews itself while in use).
VORTEX_SESSION_HOURS=12
# Leave empty to generate one automatically in the data folder.
VORTEX_SECRET_KEY=
# Comma-separated list of origins allowed to call the API from a browser.
VORTEX_CORS_ORIGINS=http://localhost:3000
# Requests per minute per client IP on /v1 and /api (0 disables).
VORTEX_RATE_LIMIT_PER_MINUTE=120
# Seconds to wait for the model backend before giving up.
VORTEX_REQUEST_TIMEOUT=300
# true = answer with a built-in simulator instead of a real model (UI dev, CI).
VORTEX_MOCK_BACKEND=false

# --- Files --------------------------------------------------------------------
# Max size per uploaded file, and how much file text goes to the model per answer.
VORTEX_MAX_UPLOAD_MB=25
VORTEX_RAG_CONTEXT_CHARS=8000

# --- Tools (see docs/ferramentas.md) ------------------------------------------
# Web search (SearXNG). scripts/setup-tools.ps1 starts it on this port.
VORTEX_SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_SECRET=troque-este-segredo
# Image generation (ComfyUI) and the model file it should use.
VORTEX_COMFYUI_URL=http://127.0.0.1:8188
VORTEX_IMAGE_CHECKPOINT=v1-5-pruned-emaonly.safetensors
# Code sandbox (Docker image built by scripts/setup-tools.ps1).
VORTEX_SANDBOX_IMAGE=vortex-sandbox
VORTEX_SANDBOX_TIMEOUT=60
VORTEX_SANDBOX_MEMORY=768m

# --- Database ----------------------------------------------------------------
# SQLite (default). Inside Docker the API stores it in the api-data volume.
# VORTEX_DATABASE_URL=sqlite+aiosqlite:///./data/vortex.db
# Postgres (docker compose --profile postgres up):
# VORTEX_DATABASE_URL=postgresql+asyncpg://vortex:vortex@db:5432/vortex
POSTGRES_PASSWORD=vortex

# --- Models ------------------------------------------------------------------
# Vortex's own model is built locally from open weights + models/Modelfile.
# Open-weight base it is built on (CPU-only notebook: llama3.2:3b or qwen2.5:3b-instruct-q4_K_M).
VORTEX_BASE_MODEL=qwen2.5:7b-instruct-q4_K_M
# Name of the built model in Ollama, served as "Vortex v0.2.1". See models/registry.yaml.
VORTEX_CHAT_BACKEND=ollama
VORTEX_CHAT_MODEL=vortex:0.2.1
VORTEX_EMBED_MODEL=nomic-embed-text
# Models ollama-init downloads on first start (space-separated). Must include VORTEX_BASE_MODEL.
VORTEX_PULL_MODELS=qwen2.5:7b-instruct-q4_K_M nomic-embed-text
OLLAMA_KEEP_ALIVE=30m

# Backend URLs when running the API outside Docker (compose overrides these).
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# VLLM_BASE_URL=http://localhost:8001/v1

# --- Ports --------------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
OLLAMA_PORT=11434
# 127.0.0.1 = only this computer. 0.0.0.0 = other devices on your network can open the site.
WEB_BIND=127.0.0.1
